// Cppify — Bison grammar for the C subset (roadmap 4.2)
//
// The source of src/parser/parser_bison.{cpp,hpp}, generated by Bison 3.8 and
// committed, so building needs no Bison:
//   bison -o src/parser/parser_bison.cpp --header=src/parser/parser_bison.hpp \
//         src/parser/parser_bison.y
// run_all regenerates both when Bison 3.8 is installed and fails if the
// committed copies are stale.
//
// IELR(1) rather than plain LALR(1): LALR merges states whose lookaheads then
// collide (`x :` as a label vs `a ? x : y`); IELR keeps LR(1) power with
// LALR-sized tables. The one real ambiguity, the dangling else, is resolved by
// precedence; every other conflict is a grammar bug (%expect 0).
//
// C is not context-free: whether `T * x;` declares x or multiplies depends on
// whether T names a type. The token feed (yylex below) answers that from the
// typedef table the actions fill, the classic "lexer hack". It returns
// TYPEDEF_NAME for a typedef'd identifier except right after another type
// word, so `unsigned T` keeps T an ordinary name, as the hand-written parser
// does.
//
// The AST must be the hand-written parser's exactly: same nodes, same
// desugarings (enum constants become literals, `for (int i...)` becomes a
// block, brace initializers are flattened), same positions. Declaration
// semantics are shared (ParseContext); this file owns only the syntax. Each
// symbol's location is its FIRST token, which is what the hand-written parser
// uses for an assignment, an expression statement or a constant-expression
// diagnostic.

%require "3.8"
%skeleton "lalr1.cc"
%language "c++"
%define api.namespace {minic::bisonp}
%define api.parser.class {Parser}
%define api.value.type variant
%define api.token.constructor
%define api.location.type {minic::bisonp::Pos}
%define parse.error custom
%define lr.type ielr
%locations
%expect 0
%parse-param {State& st}
%lex-param {State& st}

%code top {
// Bison's skeleton counts errors in a variable it never reads.
#if defined(__clang__) || defined(__GNUC__)
#pragma GCC diagnostic ignored "-Wunused-but-set-variable"
#endif
}

%code requires {
#include "ast.h"
#include "diagnostic.h"
#include "parse_context.h"
#include "token.h"
#include <memory>
#include <string>
#include <vector>

namespace minic { namespace bisonp {

struct Pos {
    int line = 0, col = 0;
};

// A declarator's stars and name.
struct DeclHead {
    int stars = 0;
    Token name{Tok::IDENT, "", 0, 0};
};

// One parameter as written; a definition requires the name, a prototype not.
struct ParamInfo {
    TypeSpec type;
    bool named = false;
    Token name{Tok::IDENT, "", 0, 0};
    std::vector<ParseContext::Dim> dims;
    Pos at;                 // where the name is (or was expected)
    std::string found;      // the token found instead of a name
    bool plainVoid = false; // `void` alone: f(void)
};

// Everything one parse needs; the generated parser holds a reference.
struct State {
    State(std::vector<Token> t, DiagnosticSink& s) : toks(std::move(t)), sink(s), ctx(s) {}
    std::vector<Token> toks;
    size_t next = 0;
    DiagnosticSink& sink;
    ParseContext ctx;
    std::unique_ptr<Program> prog = std::make_unique<Program>();
    std::vector<ParseContext::TypeWords> declType;   // base type of the declarator list being parsed
    std::vector<SwitchStmt*> switches;
    bool typeSeen = false;     // a type word earlier in the current specifier run
    Tok prev = Tok::END_OF_FILE;
    Token last{Tok::END_OF_FILE, "", 0, 0};   // most recently fed token: the lookahead at a reduction
    int open = 0;              // unclosed ( and [, for the nesting limit
    bool quietNext = false;    // a diagnostic was already given for this syntax error
    bool tooDeep = false;      // the nesting limit was reported (once is enough)
};

}}  // namespace minic::bisonp

// A symbol's location is its first token's.
#define YYLLOC_DEFAULT(Cur, Rhs, N) \
    do { (Cur) = (N) ? YYRHSLOC(Rhs, 1) : YYRHSLOC(Rhs, 0); } while (0)
}

%code {
namespace minic { namespace bisonp {
Parser::symbol_type yylex(State& st);
}}
namespace {
using namespace minic;
template <class T> T* at(T* n, const minic::bisonp::Pos& p) { n->line = p.line; n->col = p.col; return n; }
template <class T> T* at(T* n, const Node& from) { n->line = from.line; n->col = from.col; return n; }
std::unique_ptr<Expr> binary(BinOp op, std::unique_ptr<Expr> l, std::unique_ptr<Expr> r, const minic::bisonp::Pos& p) {
    return std::unique_ptr<Expr>(at(new BinaryExpr(op, std::move(l), std::move(r)), p));
}
std::unique_ptr<Expr> unary(UnOp op, std::unique_ptr<Expr> e, const minic::bisonp::Pos& p) {
    return std::unique_ptr<Expr>(at(new UnaryExpr(op, std::move(e)), p));
}
// The effect of one prefix_item (codes as assigned in the grammar).
void apply(ParseContext::TypeWords& w, int code) {
    switch (code) {
        case 0: w.isStatic = true; return;
        case 1: return;   // const, extern: no meaning here
        case 2: w.sawUnsigned = true; break;
        case 4: w.sawLong = true; break;
        case 5: w.sawShort = true; break;
        default: break;
    }
    w.sawIntWord = w.sawAny = true;
    w.t.base = BaseType::INT;
}
char decodeChar(const std::string& lex) {
    if (lex.size() >= 3 && lex[1] == '\\') {
        switch (lex[2]) {
            case 'n': return '\n';  case 't': return '\t';  case 'r': return '\r';  case '0': return '\0';
            case '\\': return '\\'; case '\'': return '\'';
            default: return lex[2];
        }
    }
    return lex.size() >= 2 ? lex[1] : '\0';
}
}  // namespace
}

%token <Token> IDENT "an identifier" TYPEDEF_NAME "a type name"
%token <Token> INT_LIT "an integer" FLOAT_LIT "a number" CHAR_LIT "a character" STRING_LIT "a string"
%token <Token> INT "'int'" CHAR "'char'" FLOAT "'float'" VOID "'void'" LONG "'long'" SHORT "'short'"
%token <Token> UNSIGNED "'unsigned'" SIGNED "'signed'" DOUBLE "'double'" CONST "'const'" STATIC "'static'" EXTERN "'extern'"
%token <Token> IF "'if'" ELSE "'else'" WHILE "'while'" FOR "'for'" DO "'do'" RETURN "'return'" BREAK "'break'"
%token <Token> CONTINUE "'continue'" STRUCT "'struct'" TYPEDEF "'typedef'" ENUM "'enum'" SIZEOF "'sizeof'"
%token <Token> SWITCH "'switch'" CASE "'case'" DEFAULT "'default'" GOTO "'goto'"
%token <Token> PLUS "'+'" MINUS "'-'" STAR "'*'" SLASH "'/'" PERCENT "'%'"
%token <Token> ASSIGN "'='" PLUS_ASSIGN "'+='" MINUS_ASSIGN "'-='" STAR_ASSIGN "'*='" SLASH_ASSIGN "'/='"
%token <Token> PERCENT_ASSIGN "'%='" AND_ASSIGN "'&='" OR_ASSIGN "'|='" XOR_ASSIGN "'^='" SHL_ASSIGN "'<<='" SHR_ASSIGN "'>>='"
%token <Token> EQ "'=='" NE "'!='" LT "'<'" LE "'<='" GT "'>'" GE "'>='" ANDAND "'&&'" OROR "'||'" NOT "'!'"
%token <Token> BITAND "'&'" BITOR "'|'" BITXOR "'^'" BITNOT "'~'" SHL "'<<'" SHR "'>>'" INC "'++'" DEC "'--'"
%token <Token> DOT "'.'" ARROW "'->'" QUESTION "'?'" COLON "':'"
%token <Token> LPAREN "'('" RPAREN "')'" LBRACE "'{'" RBRACE "'}'" LBRACKET "'['" RBRACKET "']'" COMMA "','" SEMI "';'"
%token <Token> LEXERROR "an invalid token"

%precedence LOWER_THAN_ELSE
%precedence ELSE

%type <std::unique_ptr<Expr>> expression assignment conditional logical_or logical_and bit_or bit_xor bit_and
%type <std::unique_ptr<Expr>> equality relational shift additive multiplicative cast unary postfix primary expr_opt
%type <std::vector<std::unique_ptr<Expr>>> args
%type <AssignOp> assign_op
%type <ParseContext::TypeWords> decl_specs prefix_list type_end struct_spec enum_spec
%type <TypeSpec> type_name
%type <int> stars stars1 prefix_item decl_pushed
%type <DeclHead> named
%type <ParseContext::Dim> dim
%type <std::vector<ParseContext::Dim>> dims
%type <ParseContext::Initializer> init_opt
%type <ParseContext::InitNode> init_node
%type <std::vector<ParseContext::InitNode>> init_items init_list
%type <std::unique_ptr<VarDecl>> var_declarator
%type <std::vector<std::unique_ptr<VarDecl>>> var_declarators
%type <ParamInfo> param
%type <std::vector<ParamInfo>> params param_list
%type <std::unique_ptr<CompoundStmt>> compound
%type <std::vector<std::unique_ptr<Stmt>>> block_items block_item local_decl
%type <std::unique_ptr<Stmt>> statement

%start program

%%

program
    : %empty
    | program top_decl
    ;

top_decl
    : typedef_decl
    | decl_specs SEMI
    | decl_pushed var_declarators SEMI {
          st.declType.resize($1);
          for (auto& d : $2) st.prog->decls.push_back(std::move(d));
      }
    | decl_pushed named LPAREN params RPAREN compound {
          // A function definition. Every parameter must be named.
          TypeSpec rt = st.ctx.finishType(st.declType[$1]);
          rt.ptrDepth += $2.stars;
          st.declType.resize($1);
          auto fn = std::make_unique<FuncDecl>(rt, $2.name.lexeme);
          fn->line = $2.name.line; fn->col = $2.name.col;
          std::vector<ParamInfo>& ps = $4;
          bool voidOnly = ps.size() == 1 && ps[0].plainVoid;
          if (!voidOnly)
              for (auto& p : ps) {
                  if (!p.named) {
                      st.sink.add(p.at.line, p.at.col, "expected a parameter name but found '" + p.found + "'");
                      continue;
                  }
                  fn->params.push_back(st.ctx.parameter(p.type, p.name, p.dims));
              }
          fn->body = std::move($6);
          st.prog->decls.push_back(std::move(fn));
      }
    | decl_pushed named LPAREN params RPAREN SEMI {
          // A prototype: functions are collected before any body is checked,
          // so it carries nothing this compiler needs and is discarded.
          st.declType.resize($1);
      }
    | error SEMI   { yyerrok; st.declType.clear(); }
    | error RBRACE { yyerrok; st.declType.clear(); }
    ;

/* A declaration's base type, kept on st.declType while its declarators are
   parsed (each declarator adds its own stars and dimensions to it). The value
   is its index: the declaration truncates the stack back to it when done,
   which also discards anything a failed inner declaration left behind (error
   recovery unwinds without running that declaration's own action). */
decl_pushed
    : decl_specs { $$ = static_cast<int>(st.declType.size()); st.declType.push_back($1); }
    ;

/* ---- types ----------------------------------------------------------------- */

decl_specs
    : type_end    { $$ = $1; }
    | prefix_list {
          if (!$1.sawAny) {
              st.sink.add(st.last.line, st.last.col,
                          "expected a type (int, char, float, void, struct or a typedef name)");
              st.quietNext = true;
              YYERROR;
          }
          $$ = $1;
      }
    | prefix_list type_end {
          $$ = $1;
          $$.t = $2.t;
          $$.sawAny = true;
      }
    ;

/* Width, signedness and the ignored qualifiers combine in any order. */
prefix_list
    : prefix_item             { $$ = ParseContext::TypeWords{}; apply($$, $1); }
    | prefix_list prefix_item { $$ = $1; apply($$, $2); }
    ;

prefix_item
    : STATIC   { $$ = 0; }
    | CONST    { $$ = 1; }
    | EXTERN   { $$ = 1; }
    | UNSIGNED { $$ = 2; }
    | SIGNED   { $$ = 3; }
    | LONG     { $$ = 4; }
    | SHORT    { $$ = 5; }
    | INT      { $$ = 6; }
    ;

/* A word that ends the specifier list (after it, no more type words). */
type_end
    : CHAR         { $$.t.base = BaseType::CHAR;  $$.sawAny = true; }
    | FLOAT        { $$.t.base = BaseType::FLOAT; $$.sawAny = true; }
    | DOUBLE       { $$.t.base = BaseType::FLOAT; $$.t.isDouble = true; $$.sawAny = true; }
    | VOID         { $$.t.base = BaseType::VOID;  $$.sawAny = true; }
    | struct_spec  { $$ = $1; }
    | enum_spec    { $$ = $1; }
    | TYPEDEF_NAME { $$.t = st.ctx.typedefs[$1.lexeme]; $$.sawAny = true; }
    ;

struct_spec
    : STRUCT IDENT {
          $$.t = TypeSpec{};
          $$.t.base = BaseType::STRUCT;
          $$.t.structId = st.ctx.structReference($2.lexeme, $2.line, $2.col);
          $$.sawAny = true;
      }
    | STRUCT IDENT LBRACE { st.ctx.beginStruct($2.lexeme, $2.line, $2.col); } fields RBRACE {
          $$.t = TypeSpec{};
          $$.t.base = BaseType::STRUCT;
          $$.t.structId = st.ctx.structs.find($2.lexeme);
          st.ctx.finishStruct();
          $$.sawAny = true;
      }
    | STRUCT LBRACE <int>{ $$ = st.ctx.beginStruct("", $2.line, $2.col); } fields RBRACE {
          $$.t = TypeSpec{};
          $$.t.base = BaseType::STRUCT;
          $$.t.structId = $3;
          st.ctx.finishStruct();
          $$.sawAny = true;
      }
    ;

fields
    : %empty
    | fields decl_pushed field_declarators SEMI { st.declType.resize($2); }
    ;

field_declarators
    : field_declarator
    | field_declarators COMMA field_declarator
    ;

field_declarator
    : named dims {
          TypeSpec t = st.ctx.finishType(st.declType.back());
          t.ptrDepth += $1.stars;
          st.ctx.applyDims(t, $2, false);
          st.ctx.addField(t, $1.name);
      }
    ;

enum_spec
    : ENUM IDENT                                         { $$.sawAny = true; }
    | ENUM IDENT LBRACE { st.ctx.resetEnum(); } enumerators RBRACE { $$.sawAny = true; }
    | ENUM LBRACE { st.ctx.resetEnum(); } enumerators RBRACE       { $$.sawAny = true; }
    ;

enumerators
    : %empty
    | enum_list
    | enum_list COMMA
    ;

enum_list
    : enumerator
    | enum_list COMMA enumerator
    ;

enumerator
    : IDENT { st.ctx.addEnumerator($1.lexeme, false, 0); }
    | IDENT ASSIGN conditional {
          st.ctx.addEnumerator($1.lexeme, true, st.ctx.constInt(*$3, @3.line, @3.col, "an enumerator value"));
      }
    ;

typedef_decl
    : TYPEDEF decl_pushed typedef_list SEMI { st.declType.resize($2); }
    ;

typedef_list
    : typedef_item
    | typedef_list COMMA typedef_item
    ;

typedef_item
    : named dims {
          TypeSpec t = st.ctx.finishType(st.declType.back());
          t.ptrDepth += $1.stars;
          st.ctx.applyDims(t, $2, false);
          st.ctx.typedefs[$1.name.lexeme] = t;
      }
    ;

/* `*`s of one declarator, each optionally followed by `const`. */
stars
    : %empty { $$ = 0; }
    | stars1 { $$ = $1; }
    ;

stars1
    : STAR         { $$ = 1; }
    | stars1 STAR  { $$ = $1 + 1; }
    | stars1 CONST { $$ = $1; }
    ;

/* A declarator: its stars and its name. After a `*` the name may be one that
   is also a typedef name (`T *T`), which the token feed reports as
   TYPEDEF_NAME since it cannot know a declarator is coming. Right after the
   specifiers it may not, or `T x` and `T` alone would be ambiguous. */
named
    : IDENT               { $$.name = $1; }
    | stars1 IDENT        { $$.stars = $1; $$.name = $2; }
    | stars1 TYPEDEF_NAME { $$.stars = $1; $$.name = $2; }
    ;

type_name
    : decl_specs stars { $$ = st.ctx.finishType($1); $$.ptrDepth += $2; }
    ;

dims
    : %empty   { }
    | dims dim { $$ = std::move($1); $$.push_back(std::move($2)); }
    ;

dim
    : LBRACKET RBRACKET             { $$.line = $1.line; $$.col = $1.col; }
    | LBRACKET conditional RBRACKET {
          $$.line = $1.line; $$.col = $1.col;
          $$.exprLine = @2.line; $$.exprCol = @2.col;
          $$.size = std::move($2);
      }
    ;

/* ---- variable declarators ---------------------------------------------------- */

var_declarators
    : var_declarator                        { $$.push_back(std::move($1)); }
    | var_declarators COMMA var_declarator  { $$ = std::move($1); $$.push_back(std::move($3)); }
    ;

var_declarator
    : named dims <TypeSpec>{
          // Dimensions are applied before the initializer is read, so their
          // diagnostics come first, as in the hand-written parser.
          $$ = st.ctx.finishType(st.declType.back());
          $$.ptrDepth += $1.stars;
          st.ctx.applyDims($$, $2, true);
      } init_opt {
          $$ = st.ctx.declarator($3, $1.name, std::move($4));
      }
    ;

init_opt
    : %empty { $$.kind = ParseContext::Initializer::NONE; }
    | ASSIGN init_node {
          ParseContext::InitNode& n = $2;
          const TypeSpec& t = $<TypeSpec>0;
          if (n.isList) {
              $$.kind = ParseContext::Initializer::LIST;
              $$.list = std::move(n);
          } else if (t.isArray && n.expr->kind == NodeKind::StringLit &&
                     n.expr->line == @2.line && n.expr->col == @2.col) {
              // `char s[] = "abc"`: a bare string literal (not parenthesised).
              $$.kind = ParseContext::Initializer::STRING;
              $$.str = Token{Tok::STRING_LIT, static_cast<StringLit&>(*n.expr).value, n.expr->line, n.expr->col};
          } else {
              $$.kind = ParseContext::Initializer::EXPR;
              $$.expr = std::move(n.expr);
          }
      }
    ;

init_node
    : assignment            { $$.expr = std::move($1); $$.line = @1.line; $$.col = @1.col; }
    | LBRACE init_list RBRACE {
          $$.isList = true;
          $$.kids = std::move($2);
          $$.line = $1.line; $$.col = $1.col;
      }
    ;

init_list
    : %empty           { }
    | init_items       { $$ = std::move($1); }
    | init_items COMMA { $$ = std::move($1); }
    ;

init_items
    : init_node                  { $$.push_back(std::move($1)); }
    | init_items COMMA init_node { $$ = std::move($1); $$.push_back(std::move($3)); }
    ;

/* ---- parameters ------------------------------------------------------------- */

params
    : %empty     { }
    | param_list { $$ = std::move($1); }
    | param_list COMMA DOT DOT DOT { $$ = std::move($1); }   /* a variadic prototype */
    ;

param_list
    : param                  { $$.push_back(std::move($1)); }
    | param_list COMMA param { $$ = std::move($1); $$.push_back(std::move($3)); }
    ;

param
    : decl_specs {
          $$.type = st.ctx.finishType($1);
          $$.at = Pos{st.last.line, st.last.col};
          $$.found = st.last.lexeme;
          $$.plainVoid = $$.type.base == BaseType::VOID;
      }
    | decl_specs stars1 {
          $$.type = st.ctx.finishType($1);
          $$.type.ptrDepth += $2;
          $$.at = Pos{st.last.line, st.last.col};
          $$.found = st.last.lexeme;
      }
    | decl_specs named dims {
          $$.type = st.ctx.finishType($1);
          $$.type.ptrDepth += $2.stars;
          $$.named = true;
          $$.name = $2.name;
          $$.dims = std::move($3);
      }
    ;

/* ---- statements ------------------------------------------------------------- */

compound
    : LBRACE block_items RBRACE {
          $$ = std::make_unique<CompoundStmt>();
          $$->line = $1.line; $$->col = $1.col;
          $$->stmts = std::move($2);
      }
    | LBRACE block_items IDENT COLON RBRACE {
          // `label: }`: the label marks an empty statement.
          $$ = std::make_unique<CompoundStmt>();
          $$->line = $1.line; $$->col = $1.col;
          $$->stmts = std::move($2);
          std::unique_ptr<Stmt> empty(at(new ExprStmt(nullptr), @3));
          $$->stmts.emplace_back(at(new LabelStmt($3.lexeme, std::move(empty)), @3));
      }
    | LBRACE block_items error RBRACE {
          yyerrok;
          $$ = std::make_unique<CompoundStmt>();
          $$->line = $1.line; $$->col = $1.col;
          $$->stmts = std::move($2);
      }
    ;

block_items
    : %empty { }
    | block_items block_item {
          $$ = std::move($1);
          for (auto& s : $2) $$.push_back(std::move(s));
      }
    ;

block_item
    : statement       { $$.push_back(std::move($1)); }
    | local_decl      { $$ = std::move($1); }
    | typedef_decl    { }
    | decl_specs SEMI { }   /* a bare `struct S { ... };` inside a function */
    | error SEMI      { yyerrok; }
    ;

local_decl
    : decl_pushed var_declarators SEMI {
          bool isStatic = st.declType[$1].isStatic;
          st.declType.resize($1);
          for (auto& d : $2) {
              d->isStatic = isStatic;
              auto ds = std::make_unique<DeclStmt>();
              ds->line = d->line; ds->col = d->col;
              ds->decl = std::move(d);
              $$.push_back(std::move(ds));
          }
      }
    ;

statement
    : compound { $$ = std::move($1); }
    | IF LPAREN expression RPAREN statement %prec LOWER_THAN_ELSE {
          $$.reset(at(new IfStmt(std::move($3), std::move($5), nullptr), @1));
      }
    | IF LPAREN expression RPAREN statement ELSE statement {
          $$.reset(at(new IfStmt(std::move($3), std::move($5), std::move($7)), @1));
      }
    | WHILE LPAREN expression RPAREN statement {
          $$.reset(at(new WhileStmt(std::move($3), std::move($5)), @1));
      }
    | DO statement WHILE LPAREN expression RPAREN SEMI {
          $$.reset(at(new DoStmt(std::move($2), std::move($5)), @1));
      }
    | FOR LPAREN expr_opt SEMI expr_opt SEMI expr_opt RPAREN statement {
          $$.reset(at(new ForStmt(std::move($3), std::move($5), std::move($7), std::move($9)), @1));
      }
    | FOR LPAREN local_decl expr_opt SEMI expr_opt RPAREN statement {
          // `for (int i = 0; ...)` is desugared into { int i = 0; for (; ...) body }.
          auto block = std::make_unique<CompoundStmt>();
          block->line = @1.line; block->col = @1.col;
          for (auto& d : $3) block->stmts.push_back(std::move(d));
          block->stmts.emplace_back(at(new ForStmt(nullptr, std::move($4), std::move($6), std::move($8)), @1));
          $$ = std::move(block);
      }
    | RETURN expr_opt SEMI   { $$.reset(at(new ReturnStmt(std::move($2)), @1)); }
    | BREAK SEMI             { $$.reset(at(new BreakStmt(), @1)); }
    | CONTINUE SEMI          { $$.reset(at(new ContinueStmt(), @1)); }
    | GOTO IDENT SEMI        { $$.reset(at(new GotoStmt($2.lexeme), @1)); }
    | IDENT COLON statement  { $$.reset(at(new LabelStmt($1.lexeme, std::move($3)), @1)); }
    | switch_head switch_items RBRACE {
          $$.reset(st.switches.back());
          st.switches.pop_back();
      }
    | switch_head switch_items error RBRACE {
          // Recovery inside a switch body stops at its '}', as in a block.
          yyerrok;
          $$.reset(st.switches.back());
          st.switches.pop_back();
      }
    | expression SEMI { $$.reset(at(new ExprStmt(std::move($1)), @1)); }
    | SEMI            { $$.reset(at(new ExprStmt(nullptr), @1)); }
    ;

switch_head
    : SWITCH LPAREN expression RPAREN LBRACE {
          auto* sw = new SwitchStmt();
          sw->line = @1.line; sw->col = @1.col;
          sw->cond = std::move($3);
          st.switches.push_back(sw);
      }
    ;

switch_items
    : %empty
    | switch_items switch_item
    ;

switch_item
    : CASE conditional COLON {
          SwitchCase sc;
          sc.line = $1.line; sc.col = $1.col;
          sc.value = st.ctx.constInt(*$2, @2.line, @2.col, "a case label");
          st.switches.back()->cases.push_back(std::move(sc));
      }
    | DEFAULT COLON {
          SwitchCase sc;
          sc.line = $1.line; sc.col = $1.col;
          sc.isDefault = true;
          st.switches.back()->cases.push_back(std::move(sc));
      }
    | block_item {
          SwitchStmt* sw = st.switches.back();
          if (sw->cases.empty()) {
              if (!$1.empty())
                  st.sink.add(@1.line, @1.col, "statement before the first 'case' or 'default' in a switch");
          } else {
              for (auto& s : $1) sw->cases.back().stmts.push_back(std::move(s));
          }
      }
    ;

expr_opt
    : %empty     { }
    | expression { $$ = std::move($1); }
    ;

/* ---- expressions: one level per precedence, lowest first --------------------- */

expression
    : assignment { $$ = std::move($1); }
    | expression COMMA assignment { $$.reset(at(new CommaExpr(std::move($1), std::move($3)), @2)); }
    ;

assignment
    : conditional { $$ = std::move($1); }
    | conditional assign_op assignment {
          NodeKind k = $1->kind;
          bool deref = k == NodeKind::UnaryExpr && static_cast<UnaryExpr&>(*$1).op == UnOp::DEREF;
          if (k != NodeKind::IdentExpr && k != NodeKind::IndexExpr && k != NodeKind::MemberExpr && !deref)
              st.sink.add(@1.line, @1.col,
                          "left-hand side of assignment must be a variable, array element, struct field or dereferenced pointer");
          $$.reset(at(new AssignExpr($2, std::move($1), std::move($3)), @1));
      }
    ;

assign_op
    : ASSIGN         { $$ = AssignOp::ASSIGN; }
    | PLUS_ASSIGN    { $$ = AssignOp::PLUS_ASSIGN; }
    | MINUS_ASSIGN   { $$ = AssignOp::MINUS_ASSIGN; }
    | STAR_ASSIGN    { $$ = AssignOp::STAR_ASSIGN; }
    | SLASH_ASSIGN   { $$ = AssignOp::SLASH_ASSIGN; }
    | PERCENT_ASSIGN { $$ = AssignOp::PERCENT_ASSIGN; }
    | AND_ASSIGN     { $$ = AssignOp::AND_ASSIGN; }
    | OR_ASSIGN      { $$ = AssignOp::OR_ASSIGN; }
    | XOR_ASSIGN     { $$ = AssignOp::XOR_ASSIGN; }
    | SHL_ASSIGN     { $$ = AssignOp::SHL_ASSIGN; }
    | SHR_ASSIGN     { $$ = AssignOp::SHR_ASSIGN; }
    ;

conditional
    : logical_or { $$ = std::move($1); }
    | logical_or QUESTION expression COLON conditional {
          $$.reset(at(new CondExpr(std::move($1), std::move($3), std::move($5)), @2));
      }
    ;

logical_or
    : logical_and { $$ = std::move($1); }
    | logical_or OROR logical_and { $$ = binary(BinOp::LOGOR, std::move($1), std::move($3), @2); }
    ;

logical_and
    : bit_or { $$ = std::move($1); }
    | logical_and ANDAND bit_or { $$ = binary(BinOp::LOGAND, std::move($1), std::move($3), @2); }
    ;

bit_or
    : bit_xor { $$ = std::move($1); }
    | bit_or BITOR bit_xor { $$ = binary(BinOp::BITOR, std::move($1), std::move($3), @2); }
    ;

bit_xor
    : bit_and { $$ = std::move($1); }
    | bit_xor BITXOR bit_and { $$ = binary(BinOp::BITXOR, std::move($1), std::move($3), @2); }
    ;

bit_and
    : equality { $$ = std::move($1); }
    | bit_and BITAND equality { $$ = binary(BinOp::BITAND, std::move($1), std::move($3), @2); }
    ;

equality
    : relational { $$ = std::move($1); }
    | equality EQ relational { $$ = binary(BinOp::EQ, std::move($1), std::move($3), @2); }
    | equality NE relational { $$ = binary(BinOp::NE, std::move($1), std::move($3), @2); }
    ;

relational
    : shift { $$ = std::move($1); }
    | relational LT shift { $$ = binary(BinOp::LT, std::move($1), std::move($3), @2); }
    | relational LE shift { $$ = binary(BinOp::LE, std::move($1), std::move($3), @2); }
    | relational GT shift { $$ = binary(BinOp::GT, std::move($1), std::move($3), @2); }
    | relational GE shift { $$ = binary(BinOp::GE, std::move($1), std::move($3), @2); }
    ;

shift
    : additive { $$ = std::move($1); }
    | shift SHL additive { $$ = binary(BinOp::SHL, std::move($1), std::move($3), @2); }
    | shift SHR additive { $$ = binary(BinOp::SHR, std::move($1), std::move($3), @2); }
    ;

additive
    : multiplicative { $$ = std::move($1); }
    | additive PLUS multiplicative  { $$ = binary(BinOp::ADD, std::move($1), std::move($3), @2); }
    | additive MINUS multiplicative { $$ = binary(BinOp::SUB, std::move($1), std::move($3), @2); }
    ;

multiplicative
    : cast { $$ = std::move($1); }
    | multiplicative STAR cast    { $$ = binary(BinOp::MUL, std::move($1), std::move($3), @2); }
    | multiplicative SLASH cast   { $$ = binary(BinOp::DIV, std::move($1), std::move($3), @2); }
    | multiplicative PERCENT cast { $$ = binary(BinOp::MOD, std::move($1), std::move($3), @2); }
    ;

/* C's own split: a cast applies to a cast-expression, sizeof to a unary one,
   so `sizeof (int) + 1` is (sizeof(int)) + 1 with no ambiguity. */
cast
    : unary { $$ = std::move($1); }
    | LPAREN type_name RPAREN cast { $$.reset(at(new CastExpr($2, std::move($4)), @1)); }
    ;

unary
    : postfix { $$ = std::move($1); }
    | SIZEOF LPAREN type_name dims RPAREN {
          auto* sz = at(new SizeofExpr(), @1);
          sz->ofType = true;
          sz->type = $3;
          st.ctx.applyDims(sz->type, $4, false);
          sz->value = st.ctx.sizeofType(sz->type);
          $$.reset(sz);
      }
    | SIZEOF unary {
          auto* sz = at(new SizeofExpr(), @1);
          sz->operand = std::move($2);
          $$.reset(sz);
      }
    | BITAND cast { $$ = unary(UnOp::ADDR,    std::move($2), @1); }
    | STAR cast   { $$ = unary(UnOp::DEREF,   std::move($2), @1); }
    | NOT cast    { $$ = unary(UnOp::NOT,     std::move($2), @1); }
    | BITNOT cast { $$ = unary(UnOp::BITNOT,  std::move($2), @1); }
    | MINUS cast  { $$ = unary(UnOp::NEG,     std::move($2), @1); }
    | PLUS cast   { $$ = unary(UnOp::POS,     std::move($2), @1); }
    | INC cast    { $$ = unary(UnOp::PRE_INC, std::move($2), @1); }
    | DEC cast    { $$ = unary(UnOp::PRE_DEC, std::move($2), @1); }
    ;

/* Postfix forms take the position of the expression they apply to. */
postfix
    : primary { $$ = std::move($1); }
    | postfix LBRACKET expression RBRACKET {
          Expr& base = *$1;
          $$.reset(at(new IndexExpr(std::move($1), std::move($3)), base));
      }
    | postfix LPAREN RPAREN {
          std::string callee;
          if ($1->kind == NodeKind::IdentExpr) callee = static_cast<IdentExpr&>(*$1).name;
          else st.sink.add($1->line, $1->col, "'(' follows an expression that is not a function name");
          $$.reset(at(new CallExpr(callee), *$1));
      }
    | postfix LPAREN args RPAREN {
          std::string callee;
          if ($1->kind == NodeKind::IdentExpr) callee = static_cast<IdentExpr&>(*$1).name;
          else st.sink.add($1->line, $1->col, "'(' follows an expression that is not a function name");
          auto* c = at(new CallExpr(callee), *$1);
          c->args = std::move($3);
          $$.reset(c);
      }
    | postfix DOT IDENT {
          Expr& base = *$1;
          $$.reset(at(new MemberExpr(std::move($1), $3.lexeme, false), base));
      }
    | postfix ARROW IDENT {
          Expr& base = *$1;
          $$.reset(at(new MemberExpr(std::move($1), $3.lexeme, true), base));
      }
    | postfix INC {
          Expr& base = *$1;
          $$.reset(at(new UnaryExpr(UnOp::POST_INC, std::move($1)), base));
      }
    | postfix DEC {
          Expr& base = *$1;
          $$.reset(at(new UnaryExpr(UnOp::POST_DEC, std::move($1)), base));
      }
    ;

args
    : assignment            { $$.push_back(std::move($1)); }
    | args COMMA assignment { $$ = std::move($1); $$.push_back(std::move($3)); }
    ;

primary
    : IDENT {
          auto ec = st.ctx.enumConsts.find($1.lexeme);
          if (ec != st.ctx.enumConsts.end()) $$.reset(at(new IntLit(ec->second), @1));
          else                               $$.reset(at(new IdentExpr($1.lexeme), @1));
      }
    | INT_LIT {
          // stoull, not stoll: an unsigned literal may exceed LLONG_MAX.
          auto* e = at(new IntLit(static_cast<long long>(std::stoull($1.lexeme))), @1);
          for (char ch : $1.lexeme) {
              if (ch == 'u' || ch == 'U') e->unsignedSuffix = true;
              if (ch == 'l' || ch == 'L') e->longSuffix = true;
          }
          $$.reset(e);
      }
    | FLOAT_LIT  { $$.reset(at(new FloatLit(std::stod($1.lexeme)), @1)); }
    | CHAR_LIT   { $$.reset(at(new CharLit(decodeChar($1.lexeme)), @1)); }
    | STRING_LIT { $$.reset(at(new StringLit($1.lexeme), @1)); }
    | LPAREN expression RPAREN { $$ = std::move($2); }
    ;

%%

namespace minic { namespace bisonp {

namespace {

bool isTypeWord(Tok t) {
    switch (t) {
        case Tok::KW_INT: case Tok::KW_CHAR: case Tok::KW_FLOAT: case Tok::KW_VOID: case Tok::KW_LONG:
        case Tok::KW_SHORT: case Tok::KW_UNSIGNED: case Tok::KW_SIGNED: case Tok::KW_DOUBLE:
            return true;
        default:
            return false;
    }
}

Parser::token_kind_type kindOf(Tok t) {
    using K = Parser::token;
    switch (t) {
        case Tok::IDENT: return K::IDENT;           case Tok::INT_LIT: return K::INT_LIT;
        case Tok::FLOAT_LIT: return K::FLOAT_LIT;   case Tok::CHAR_LIT: return K::CHAR_LIT;
        case Tok::STRING_LIT: return K::STRING_LIT;
        case Tok::KW_INT: return K::INT;            case Tok::KW_CHAR: return K::CHAR;
        case Tok::KW_FLOAT: return K::FLOAT;        case Tok::KW_VOID: return K::VOID;
        case Tok::KW_LONG: return K::LONG;          case Tok::KW_SHORT: return K::SHORT;
        case Tok::KW_UNSIGNED: return K::UNSIGNED;  case Tok::KW_SIGNED: return K::SIGNED;
        case Tok::KW_DOUBLE: return K::DOUBLE;      case Tok::KW_CONST: return K::CONST;
        case Tok::KW_STATIC: return K::STATIC;      case Tok::KW_EXTERN: return K::EXTERN;
        case Tok::KW_IF: return K::IF;              case Tok::KW_ELSE: return K::ELSE;
        case Tok::KW_WHILE: return K::WHILE;        case Tok::KW_FOR: return K::FOR;
        case Tok::KW_DO: return K::DO;              case Tok::KW_RETURN: return K::RETURN;
        case Tok::KW_BREAK: return K::BREAK;        case Tok::KW_CONTINUE: return K::CONTINUE;
        case Tok::KW_STRUCT: return K::STRUCT;      case Tok::KW_TYPEDEF: return K::TYPEDEF;
        case Tok::KW_ENUM: return K::ENUM;          case Tok::KW_SIZEOF: return K::SIZEOF;
        case Tok::KW_SWITCH: return K::SWITCH;      case Tok::KW_CASE: return K::CASE;
        case Tok::KW_DEFAULT: return K::DEFAULT;    case Tok::KW_GOTO: return K::GOTO;
        case Tok::OP_PLUS: return K::PLUS;          case Tok::OP_MINUS: return K::MINUS;
        case Tok::OP_STAR: return K::STAR;          case Tok::OP_SLASH: return K::SLASH;
        case Tok::OP_PERCENT: return K::PERCENT;    case Tok::OP_ASSIGN: return K::ASSIGN;
        case Tok::OP_PLUS_ASSIGN: return K::PLUS_ASSIGN;     case Tok::OP_MINUS_ASSIGN: return K::MINUS_ASSIGN;
        case Tok::OP_STAR_ASSIGN: return K::STAR_ASSIGN;     case Tok::OP_SLASH_ASSIGN: return K::SLASH_ASSIGN;
        case Tok::OP_PERCENT_ASSIGN: return K::PERCENT_ASSIGN; case Tok::OP_AND_ASSIGN: return K::AND_ASSIGN;
        case Tok::OP_OR_ASSIGN: return K::OR_ASSIGN;         case Tok::OP_XOR_ASSIGN: return K::XOR_ASSIGN;
        case Tok::OP_SHL_ASSIGN: return K::SHL_ASSIGN;       case Tok::OP_SHR_ASSIGN: return K::SHR_ASSIGN;
        case Tok::OP_EQ: return K::EQ;              case Tok::OP_NE: return K::NE;
        case Tok::OP_LT: return K::LT;              case Tok::OP_LE: return K::LE;
        case Tok::OP_GT: return K::GT;              case Tok::OP_GE: return K::GE;
        case Tok::OP_AND: return K::ANDAND;         case Tok::OP_OR: return K::OROR;
        case Tok::OP_NOT: return K::NOT;            case Tok::OP_BITAND: return K::BITAND;
        case Tok::OP_BITOR: return K::BITOR;        case Tok::OP_BITXOR: return K::BITXOR;
        case Tok::OP_BITNOT: return K::BITNOT;      case Tok::OP_SHL: return K::SHL;
        case Tok::OP_SHR: return K::SHR;            case Tok::OP_INC: return K::INC;
        case Tok::OP_DEC: return K::DEC;            case Tok::OP_DOT: return K::DOT;
        case Tok::OP_ARROW: return K::ARROW;        case Tok::OP_QUESTION: return K::QUESTION;
        case Tok::OP_COLON: return K::COLON;        case Tok::LPAREN: return K::LPAREN;
        case Tok::RPAREN: return K::RPAREN;         case Tok::LBRACE: return K::LBRACE;
        case Tok::RBRACE: return K::RBRACE;         case Tok::LBRACKET: return K::LBRACKET;
        case Tok::RBRACKET: return K::RBRACKET;     case Tok::COMMA: return K::COMMA;
        case Tok::SEMI: return K::SEMI;             case Tok::END_OF_FILE: return K::YYEOF;
        case Tok::ERROR: return K::LEXERROR;
    }
    return K::LEXERROR;
}

}  // namespace

// The token feed, with the typedef-name feedback described at the top.
Parser::symbol_type yylex(State& st) {
    const Token& t = st.toks[st.next < st.toks.size() ? st.next : st.toks.size() - 1];
    if (st.next < st.toks.size() - 1) ++st.next;
    st.last = t;
    Pos p{t.line, t.col};
    Tok kind = t.type;
    bool typedefName = kind == Tok::IDENT && st.ctx.typedefs.count(t.lexeme) && !st.typeSeen &&
                       st.prev != Tok::KW_STRUCT && st.prev != Tok::KW_ENUM && st.prev != Tok::OP_DOT &&
                       st.prev != Tok::OP_ARROW && st.prev != Tok::KW_GOTO;
    if (typedefName || isTypeWord(kind)) st.typeSeen = true;
    else if (kind != Tok::KW_STATIC && kind != Tok::KW_CONST && kind != Tok::KW_EXTERN) st.typeSeen = false;
    st.prev = kind;

    // The hand-written parser refuses expressions nested more than 256 deep
    // (deeper recursion would exhaust its stack). Bison's stack would not
    // overflow, but every later stage recurses over the tree, so the same
    // limit applies here, counted as unclosed brackets.
    if (kind == Tok::LPAREN || kind == Tok::LBRACKET) {
        if (st.open >= 256) {
            if (!st.tooDeep) {
                st.sink.add(t.line, t.col, "expression nests too deeply (limit 256)");
                st.quietNext = true;
                st.tooDeep = true;
            }
            return Parser::symbol_type(Parser::token::LEXERROR, t, p);
        }
        ++st.open;
    } else if ((kind == Tok::RPAREN || kind == Tok::RBRACKET) && st.open > 0) {
        --st.open;
    }
    if (typedefName) return Parser::symbol_type(Parser::token::TYPEDEF_NAME, t, p);
    if (kind == Tok::END_OF_FILE) return Parser::make_YYEOF(p);
    return Parser::symbol_type(kindOf(kind), t, p);
}

// In the hand-written parser's wording where the expected set allows it:
// "expected ';' but found 'return'", "expected an expression ...", "expected a
// type ...", else "unexpected 'x'". The position is the offending token's in
// every case, which is what the two parsers are compared on.
void Parser::report_syntax_error(const context& ctx) const {
    if (st.quietNext) { st.quietNext = false; return; }
    std::string lexeme = ctx.token() == symbol_kind::S_YYEOF ? "<end of file>" : st.last.lexeme;
    symbol_kind_type expected[YYNTOKENS];
    int n = ctx.expected_tokens(expected, YYNTOKENS);
    auto expects = [&](symbol_kind_type k) {
        for (int i = 0; i < n; ++i) if (expected[i] == k) return true;
        return false;
    };
    std::string what;
    if (n == 1)                                                  what = symbol_name(expected[0]);
    else if (expects(symbol_kind::S_SEMI))                       what = "';'";
    else if (expects(symbol_kind::S_IDENT) && expects(symbol_kind::S_INT_LIT)) what = "an expression";
    else if (expects(symbol_kind::S_INT) && !expects(symbol_kind::S_IDENT))
        what = "a type (int, char, float, void, struct or a typedef name)";
    std::string msg = what.empty() ? "unexpected '" + lexeme + "'"
                                   : "expected " + what + " but found '" + lexeme + "'";
    st.sink.add(ctx.location().line, ctx.location().col, msg);
}

void Parser::error(const location_type& loc, const std::string& msg) {
    st.sink.add(loc.line, loc.col, msg);
}

