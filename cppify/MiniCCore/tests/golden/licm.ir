
loopy(a#0, b#1, n#2):
    i#3 = 0
    s#4 = 0
    i#3 = 0
    s#4 = 0
    t1 = a#0 * b#1
  L0:
    t0 = i#3 < n#2
    ifFalse t0 goto L1
    t2 = s#4 + t1
    s#4 = t2
    t3 = i#3 + 1
    i#3 = t3
    goto L0
  L1:
    ret s#4

main():
    param 3
    param 4
    param 5
    t0 = call loopy, 3
