
main():
    i#0 = 0
    j#1 = 0
    s#2 = 0
    s#2 = 0
    i#0 = 0
  L0:
    t0 = i#0 < 3
    ifFalse t0 goto L1
    t1 = i#0 + 1
    i#0 = t1
    j#1 = 0
  L2:
    t2 = j#1 < 3
    ifFalse t2 goto L0
    t3 = j#1 == 1
    ifFalse t3 goto L4
    goto L0
  L4:
    t4 = s#2 + 1
    s#2 = t4
    t5 = j#1 + 1
    j#1 = t5
    goto L2
  L3:
    goto L0
  L1:
    ret s#2
